{
  "name": "budget-tracker-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Учёт личного бюджета на TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node scripts/clean.mjs",
    "demo:calculations": "npm run build && node dist/calculation-demo.js",
    "demo:functions": "npm run build && node dist/functions.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
